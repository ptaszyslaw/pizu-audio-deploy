{
  "id": "/",
  "name": "PizuAudio",
  "short_name": "PizuAudio",
  "description": "Darmowe narzędzia audio działające w Twojej przeglądarce: oddzielanie wokalu od muzyki, przycinanie i konwersja do MP3 lub WAV — bez wysyłania nagrań na serwer.",
  "lang": "pl",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F7F7F8",
  "theme_color": "#EF4249",
  "categories": ["music", "entertainment", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/flac": [".flac"],
        "audio/ogg": [".ogg", ".oga", ".opus"],
        "audio/mp4": [".m4a"],
        "audio/aac": [".aac"],
        "audio/webm": [".webm"],
        "audio/x-ms-wma": [".wma"],
        "audio/aiff": [".aiff", ".aif"]
      }
    }
  ],
  "share_target": {
    "action": "/udostepnij",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "audio", "accept": ["audio/*", ".mp3", ".wav", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".aac", ".webm", ".wma", ".aiff", ".aif"] }]
    }
  }
}
