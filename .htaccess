# PizuAudio — Apache config for shared hosting

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The old address audio.ptaszynski.pl shares this folder with audio.pizu.pl:
  # one 301 straight to the new https address. Kept here, not in cPanel
  # "Redirects" — every deploy overwrites this file.
  RewriteCond %{HTTP_HOST} ^(www\.)?audio\.ptaszynski\.pl$ [NC]
  RewriteRule ^ https://audio.pizu.pl%{REQUEST_URI} [R=301,L]

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

AddType application/javascript .mjs
AddType application/wasm .wasm

<IfModule mod_headers.c>
  # index.html must always revalidate, or a redeploy white-screens cached visitors
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Vite-hashed assets are immutable — cache aggressively
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Versioned runtime (folder name changes only with a dependency update)
  <FilesMatch "^ort-wasm.*\.(wasm|mjs)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
