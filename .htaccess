# PizuAudio — Apache config for shared hosting

<IfModule mod_rewrite.c>
  RewriteEngine On
  # One address: everything but https://audio.pizu.pl that reaches this folder
  # (http, www.audio.pizu.pl, ptasior.hostilla.pl/audio/, the old
  # audio.ptaszynski.pl if it ever points here again) gets a single 301 to
  # https://audio.pizu.pl, path and query kept. Path from $1 (relative to this
  # folder), not %{REQUEST_URI}, so ptasior.hostilla.pl/audio/x lands on /x;
  # without NE Apache encodes spaces and % in the target. /.well-known stays put
  # for AutoSSL. Kept here, not in cPanel "Redirects" — every deploy overwrites
  # this file.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^audio\.pizu\.pl\.?(?::[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://audio.pizu.pl/$1 [R=301,L]
</IfModule>

AddType application/javascript .mjs
AddType application/wasm .wasm

<IfModule mod_headers.c>
  # index.html must always revalidate, or a redeploy white-screens cached visitors
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Vite-hashed assets are immutable — cache aggressively
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Versioned runtime (folder name changes only with a dependency update)
  <FilesMatch "^ort-wasm.*\.(wasm|mjs)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Security headers on every response
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # The page's CSP: scripts/deploy.mjs fills in the policy from index.html's
  # <meta> plus frame-ancestors (a <meta> can't carry it). Only on HTML —
  # workers take their CSP from their own response, and they compile WebAssembly.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://huggingface.co https://*.hf.co; frame-ancestors 'none'"
  </FilesMatch>
</IfModule>
